(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Signal" (clearance 0.25) (trace_width 0.30))
    ;; COMPLIANCE: Symmetrical Parallel 0.5mm Clearance Guard Rings Isolating H4 LED Power Switching
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
  )

  (net 0 "")
  (net 1 "VCC_12V_AVIONICS")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Master_High_Beam_Signal")
  (net 4 "Master_Low_Beam_Signal")
  (net 5 "LED_Array_Drive_Anode")

  ;; --- Component Matrix Placements ---
  
  ;; J1: Historical 3-Blade Headlight Male Socket Interface (Mates to factory 1969 harness)
  (module "Connector_Wago:Wago_3Pin_Sealed_Automotive" (layer "F.Cu") (at 30.0 50.0)
    (pad "1" tht circle (at -3.5 0) (size 3.0 3.0) (drill 1.5) (layers "*.Cu" "*.Mask") (net 2 "GND_GUARD_SHIELD"))
    (pad "2" tht circle (at 0 0) (size 3.0 3.0) (drill 1.5) (layers "*.Cu" "*.Mask") (net 4 "Master_Low_Beam_Signal"))
    (pad "3" tht circle (at 3.5 0) (size 3.0 3.0) (drill 1.5) (layers "*.Cu" "*.Mask") (net 3 "Master_High_Beam_Signal"))
  )

  ;; U1: Constant-Current Synchronous Buck LED Driver Controller Module
  (module "Housings_SOIC:SOIC-8_3.9x4.9mm_Pitch1.27mm" (layer "F.Cu") (at 60.0 50.0)
    (pad "1" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_12V_AVIONICS"))
    (pad "2" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Master_High_Beam_Signal"))
    (pad "3" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Master_Low_Beam_Signal"))
    (pad "4" smd rect (at 1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Track Left
    (pad "5" smd rect (at 1.905 2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Track Right
    (pad "6" smd rect (at -0.635 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "LED_Array_Drive_Anode"))
  )
)
