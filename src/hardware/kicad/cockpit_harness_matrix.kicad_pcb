(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Control_Bus" (clearance 0.25) (trace_width 0.25))
    ;; COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Tracks Shielding Critical Cockpit Sensor Data
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
    ;; COMPLIANCE: 3oz Heavy Copper Trace Width Parameters for High-Efficiency Thermal Fan Rails
    (clearance_class "Heavy_3oz_Avionics_Bus" (clearance 2.0) (trace_width 3.50))
  )

  (net 0 "")
  (net 1 "VCC_12V_AVIONICS")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Iris_Tracking_MIPI_Data")
  (net 4 "Pedal_Encoder_Alpha_Sig")
  (net 5 "Blower_Motor_A_Power_12V")
  (net 6 "Parallel_Bus_Line_D9")

  ;; --- Component Matrix Placements ---
  
  ;; U1: Unified Cockpit Harness Master Gateway Selector (RT Custom 16-State Multiplexer)
  (module "Housings_SOIC:SOIC-16_3.9x9.9mm_Pitch1.27mm" (layer "F.Cu") (at 50.0 50.0)
    (pad "1" smd rect (at -4.445 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_12V_AVIONICS"))
    (pad "2" smd rect (at -3.175 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Iris_Tracking_MIPI_Data"))
    (pad "3" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Pedal_Encoder_Alpha_Sig"))
    (pad "4" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Line Left
    (pad "5" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Line Right
    (pad "15" smd rect (at -3.175 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Blower_Motor_A_Power_12V"))
    (pad "16" smd rect (at -4.445 2.7) (size 0.6 1.5) (layers "F.Cu") (net 6 "Parallel_Bus_Line_D9"))
    (net_class "Heavy_3oz_Avionics_Bus" (pins "15"))
  )
)
