(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Signal" (clearance 0.25) (trace_width 0.25))
    ;; COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Lines Isolating the Center Dash Auxiliary Bus
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
  )

  (net 0 "")
  (net 1 "VCC_12V_AVIONICS")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Radio_Audio_In_Right")
  (net 4 "Radio_Audio_In_Left")
  (net 5 "Slider_AC_Potentiometer_Sig")
  (net 6 "Parallel_Register_Data_Out")

  ;; --- Component Matrix Placements ---
  
  ;; U1: Analog-to-Digital Converter Matrix (Translates 1969 physical dials to Hex registers)
  (module "Housings_SOIC:SOIC-16_3.9x9.9mm_Pitch1.27mm" (layer "F.Cu") (at 50.0 50.0)
    (pad "1" smd rect (at -4.445 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_12V_AVIONICS"))
    (pad "2" smd rect (at -3.175 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Slider_AC_Potentiometer_Sig"))
    (pad "4" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Line Left
    (pad "5" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Line Right
    (pad "14" smd rect (at 1.905 2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Radio_Audio_In_Right"))
    (pad "15" smd rect (at 3.175 2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Radio_Audio_In_Left"))
    (pad "16" smd rect (at 4.445 2.7) (size 0.6 1.5) (layers "F.Cu") (net 6 "Parallel_Register_Data_Out"))
  )
)
