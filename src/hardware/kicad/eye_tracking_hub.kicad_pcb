(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Signal" (clearance 0.20) (trace_width 0.20))
    ;; COMPLIANCE: Parallel 0.5mm Bilateral Guard Rings Shielding Iris Tracking Data Lines
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
  )

  (net 0 "")
  (net 1 "VCC_3V3")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Camera_MIPI_Data_P")
  (net 4 "Camera_MIPI_Data_N")
  (net 5 "Iris_Tracking_Telemetry_Out")

  ;; --- Component Placements ---
  
  ;; U1: Biometric Vision Processor Core (Ocular Vector Mapping Array)
  (module "Housings_SOIC:SOIC-8_3.9x4.9mm_Pitch1.27mm" (layer "F.Cu") (at 40.0 50.0)
    (pad "1" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_3V3"))
    (pad "2" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Camera_MIPI_Data_P"))
    (pad "3" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Camera_MIPI_Data_N"))
    (pad "4" smd rect (at 1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Left
    (pad "5" smd rect (at 1.905 2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Right
    (pad "6" smd rect (at 0.635 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Iris_Tracking_Telemetry_Out"))
  )
)
