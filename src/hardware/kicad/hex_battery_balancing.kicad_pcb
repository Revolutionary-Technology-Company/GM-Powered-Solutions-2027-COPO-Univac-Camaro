(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 2.4) ;; Thick 2.4mm double-sided board supporting heavy 3oz copper traces
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Control_Hex" (clearance 0.25) (trace_width 0.25))
    ;; RULE #2 COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Tracks Shielding Analog Cell Vectors
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
    ;; RULE #1 COMPLIANCE: 3oz Heavy Copper Trace Width Parameters for High-Draw Current Handling
    (clearance_class "Heavy_3oz_Traction_Bus" (clearance 6.0) (trace_width 5.0))
  )

  (net 0 "")
  (net 1 "VCC_12V_AVIONICS")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Hex_Voltage_Step_Sense_A")
  (net 4 "Hex_Voltage_Step_Sense_B")
  (net 5 "Capacitor_Bank_Discharge_Gate")
  (net 6 "Inverter_120VAC_Enable_Line")

  ;; --- Component Matrix Placements ---
  
  ;; U1: 16-State Analog Voltage Balancing Processor Core (RT Custom Hexadecimal Silicon)
  (module "Housings_SOIC:SOIC-16_3.9x9.9mm_Pitch1.27mm" (layer "F.Cu") (at 50.0 50.0)
    (pad "1" smd rect (at -4.445 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_12V_AVIONICS"))
    (pad "2" smd rect (at -3.175 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Hex_Voltage_Step_Sense_A"))
    (pad "3" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Hex_Voltage_Step_Sense_B"))
    (pad "4" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Line Left
    (pad "5" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Line Right
    (pad "15" smd rect (at -3.175 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Capacitor_Bank_Discharge_Gate"))
    (pad "16" smd rect (at -4.445 2.7) (size 0.6 1.5) (layers "F.Cu") (net 6 "Inverter_120VAC_Enable_Line"))
    (net_class "Heavy_3oz_Traction_Bus" (pins "15" "16"))
  )
)
